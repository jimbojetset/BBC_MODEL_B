<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <UseAppHost>false</UseAppHost>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InformationalVersion>0.0</InformationalVersion>
  </PropertyGroup>

  <Target Name="SetGitCommitVersion" BeforeTargets="GetAssemblyVersion" Condition="Exists('$(MSBuildProjectDirectory)/.git')">
    <Exec Command="git rev-list --count --merges origin/main"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          ConsoleToMSBuild="true"
          IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" ItemName="GitMajorVersion" />
      <Output TaskParameter="ExitCode" PropertyName="GitMajorVersionExitCode" />
    </Exec>
    <Exec Command="git rev-list --count --no-merges origin/main"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          ConsoleToMSBuild="true"
          IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" ItemName="GitMinorVersion" />
      <Output TaskParameter="ExitCode" PropertyName="GitMinorVersionExitCode" />
    </Exec>
    <PropertyGroup Condition="'$(GitMajorVersionExitCode)' == '0' and '$(GitMinorVersionExitCode)' == '0'">
      <InformationalVersion>@(GitMajorVersion).@(GitMinorVersion)</InformationalVersion>
    </PropertyGroup>
  </Target>

  <ItemGroup>
    <Folder Include="ROMS\" />
    <Compile Remove="Tests\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ppy.SDL2-CS" Version="1.0.82" />
    <PackageReference Include="SkiaSharp" Version="2.88.8" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="2.88.8" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="2.88.8" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="2.88.8" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Assets\*.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Remove="Assets\co-processor.png" Condition="Exists('Assets\co-processor.png')" />
    <EmbeddedResource Include="Assets\co-processor.png" LogicalName="BBC.TubeCoProcessor.png" Condition="Exists('Assets\co-processor.png')" />
    <None Remove="Assets\Cassette.png" Condition="Exists('Assets\Cassette.png')" />
    <EmbeddedResource Include="Assets\Cassette.png" LogicalName="BBC.Cassette.png" Condition="Exists('Assets\Cassette.png')" />
    <None Remove="Assets\CassetteLoaded.png" Condition="Exists('Assets\CassetteLoaded.png')" />
    <EmbeddedResource Include="Assets\CassetteLoaded.png" LogicalName="BBC.CassetteLoaded.png" Condition="Exists('Assets\CassetteLoaded.png')" />
    <None Remove="Assets\BBC_Logo.png" Condition="Exists('Assets\BBC_Logo.png')" />
    <EmbeddedResource Include="Assets\BBC_Logo.png" LogicalName="BBC.BBC_Logo.png" Condition="Exists('Assets\BBC_Logo.png')" />
    <None Remove="Assets\fx80v2.png" Condition="Exists('Assets\fx80v2.png')" />
    <EmbeddedResource Include="Assets\fx80v2.png" LogicalName="BBC.fx80v2.png" Condition="Exists('Assets\fx80v2.png')" />
    <None Remove="Assets\DotMatrix-Regular.ttf" Condition="Exists('Assets\DotMatrix-Regular.ttf')" />
    <EmbeddedResource Include="Assets\DotMatrix-Regular.ttf" LogicalName="BBC.DotMatrix-Regular.ttf" Condition="Exists('Assets\DotMatrix-Regular.ttf')" />
    <None Update="ROMS\*.rom">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>


</Project>
