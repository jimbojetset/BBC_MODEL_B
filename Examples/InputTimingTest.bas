10 MODE 7
20 CLS
30 PRINT "INPUT AND TIMING TEST"
40 PRINT "---------------------"
50 PRINT
60 PRINT "PRESS LETTERS, DIGITS, RETURN,"
70 PRINT "DELETE, ARROWS, OR ESCAPE."
80 PRINT "THE TIME VALUE SHOULD COUNT UP."
90 PRINT
100 T=TIME
110 REPEAT
120 A=INKEY(0)
130 IF A<>-1 PRINT "KEY ";A;" ";CHR$(A)
140 IF TIME-T>=100 PRINT "TIME ";TIME DIV 100:T=TIME
150 UNTIL FALSE
