10 MODE 0
20 CLS
30 PRINT TAB(0,0);"MODE 0 HI-RES 2 COLOUR"
40 GCOL 0,1
50 FOR X=0 TO 1279 STEP 128
60 MOVE X,0:DRAW X,1023
70 NEXT
80 FOR Y=0 TO 1023 STEP 128
90 MOVE 0,Y:DRAW 1279,Y
100 NEXT
110 MOVE 0,0:DRAW 1279,1023
120 MOVE 0,1023:DRAW 1279,0
130 FOR T=1 TO 2500:NEXT
140 MODE 1
150 CLS
160 PRINT TAB(0,0);"MODE 1 FOUR COLOUR"
170 FOR C=0 TO 3
180 GCOL 0,C
190 MOVE 0,C*250:DRAW 1279,1023-C*250
200 MOVE 0,1023-C*250:DRAW 1279,C*250
210 NEXT
220 FOR T=1 TO 2500:NEXT
230 MODE 2
240 CLS
250 ?&FE20=?&FE20 OR 1
260 FOR C=0 TO 15
270 GCOL 0,C
280 FOR Y=C*64 TO C*64+48 STEP 8
290 MOVE 0,Y:DRAW 1279,Y
300 NEXT
310 NEXT
320 PRINT TAB(0,0);"MODE 2"
330 PRINT TAB(0,1);"16 LOGICAL COLOURS"
340 PRINT TAB(0,2);"8-15 FLASH"
350 GOTO 350
