10 REM Analogue joystick test - ADVAL only
20 MODE 7
30 VDU 23,1,0;0;0;0;
40 *FX16,2
50 CLS
60 PRINT "ANALOGUE JOYSTICK TEST"
70 PRINT "READING ADVAL(1), ADVAL(2)"
80 PRINT
90 PRINT "MOVE PHYSICAL ANALOGUE STICK"
100 PRINT "PRESS FIRE TO TEST ADVAL(0)"
110 PRINT
120 PRINT "PRESS ESCAPE TO STOP"
130 REPEAT
140 X=ADVAL(1)
150 Y=ADVAL(2)
160 F=ADVAL(0)
170 PRINT TAB(0,8);"X ADVAL(1) = ";X;"      "
180 PRINT TAB(0,9);"Y ADVAL(2) = ";Y;"      "
190 PRINT TAB(0,10);"F ADVAL(0) = ";F;"      "
200 PRINT TAB(0,12);"X HEX = &";~X;"      "
210 PRINT TAB(0,13);"Y HEX = &";~Y;"      "
220 UNTIL FALSE
