10 REM Switched joystick test - user VIA PB0-PB4 only
20 MODE 7
30 VDU 23,1,0;0;0;0;
40 ?&FE62=0
50 CLS
60 PRINT "SWITCHED JOYSTICK TEST"
70 PRINT "READING USER VIA &FE60"
80 PRINT
90 PRINT "PB0 UP, PB1 DOWN, PB2 LEFT"
100 PRINT "PB3 RIGHT, PB4 FIRE"
110 PRINT
120 PRINT "PRESS ESCAPE TO STOP"
130 REPEAT
140 V=?&FE60
150 U=(V AND 1)=0
160 D=(V AND 2)=0
170 L=(V AND 4)=0
180 R=(V AND 8)=0
190 F=(V AND 16)=0
200 PRINT TAB(0,8);"RAW &FE60 = &";~V;"  "
210 PRINT TAB(0,10);"UP    ";FNSTATE(U)
220 PRINT TAB(0,11);"DOWN  ";FNSTATE(D)
230 PRINT TAB(0,12);"LEFT  ";FNSTATE(L)
240 PRINT TAB(0,13);"RIGHT ";FNSTATE(R)
250 PRINT TAB(0,14);"FIRE  ";FNSTATE(F)
260 UNTIL FALSE
270 DEF FNSTATE(P)
280 IF P THEN ="ON " ELSE ="OFF"
