{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/BBC_MODEL_B.csproj"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "scan unused code",
      "command": "${env:HOME}/.dotnet/tools/dotnet-unused",
      "type": "process",
      "args": [
        "${workspaceFolder}/BBC_MODEL_B.csproj",
        "--exclude-public",
        "true"
      ],
      "options": {
        "env": {
          "DOTNET_ROLL_FORWARD": "LatestMajor"
        }
      },
      "problemMatcher": []
    }
  ]
}
